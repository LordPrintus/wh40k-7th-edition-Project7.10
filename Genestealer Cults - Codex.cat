    <selectionEntry name="Neophyte Cavalcade" id="67ab-28ad-55c2-a66d" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Mechanised Ambush" id="f259-a634-fe53-120d" hidden="false" page="91" publicationId="f840-ed73-pubN65537">
          <description>This Formation&apos;s units of Neophyte Hybrids must start the game embarked within their transports. Vehicle units from this Formation have the Outflank special rule. Scout Sentinels from this Formation instead gain the Cult Ambush special rule.</description>
        </rule>
        <rule name="Devoted Crew" id="030e-9e5a-8fea-766b" hidden="false" page="91" publicationId="f840-ed73-pubN65537">
          <description>Roll a dice each time a vehicle from this Formation suffers a Crew Stunned or Crew Shaken result. On a 4 or more that result is ignored (though the vehicle still loses a Hull Point).</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Neophyte Hybrids" id="d75b-d849-02c3-21bc" collective="false" defaultSelectionEntryId="d5dd-f6d6-c304-8dc7" hidden="false" import="true">
