        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 4, Twin-linked</characteristic>
      </characteristics>
    </profile>
    <profile name="Genestealer Familiar" id="40c3-6e6b-c2a8-c36a" hidden="false" publicationId="f840-ed73-pubN76937" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model with a Genestealer Familiar makes two additional S4 AP- attacks with the Rending USR in close combat.  A Genestealer Familiar is represented by a separate miniature that will always remain as close as possible to it&apos;s master.  The model itself is decorative and is always ignored for game purproses - just move it to one side if it gets in the way.  Remove the Genestealer Familiar once it&apos;s master has been slain.</characteristic>
      </characteristics>
    </profile>
