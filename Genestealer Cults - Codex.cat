    <profile name="Sacred Cult Banner" id="afa7-d6cf-cbe9-68db" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly units with the Genestealer Cults Faction within 12&quot; of a model equiped with a sacred cult banner have the Furious Charge special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Scout Sentinel" id="c25e-7f8d-cc67-9047" hidden="false" page="82" publicationId="f840-ed73-pubN65537" typeId="3dadd2ff-33f1-41dd-85c7-bee5a7dfa413" typeName="Walker">
