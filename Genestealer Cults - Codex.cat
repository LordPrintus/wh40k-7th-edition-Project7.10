            <entryLink id="9658-c4c0-27af-df91" collective="false" hidden="false" import="true" targetId="0f45-5929-8943-b671" type="selectionEntry"/>
          </entryLinks>
          <selectionEntries>
            <selectionEntry name="Genestealer Cults" id="6c93-c221-79d5-90c2" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <profiles>
                <profile name="Warlord Trait: Shadow Stalker" id="daf9-1142-11a4-ffba" hidden="false" page="96" publicationId="f840-ed73-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord has the Stealth special rule.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Ambush Leader" id="934a-05a7-98bd-d411" hidden="false" page="96" publicationId="f840-ed73-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When using the Cult Ambush special rule with your Warlord or any unit he has joined, do not roll on the Cult Ambush table: you can choose the result to apply instead.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Alien Master" id="4423-6c28-9b6a-6e39" hidden="false" page="96" publicationId="f840-ed73-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All models in your Warlord&apos;s Detachment can use his Leadership in place of their own.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Born Survivor" id="c46d-5b11-6de6-8ebd" hidden="false" page="96" publicationId="f840-ed73-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord has the It Will Not Die special rule.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Wall Creeper" id="5cf3-551a-04a4-c6ff" hidden="false" page="96" publicationId="f840-ed73-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord has the Move Through Cover special rule. In addition, your Warlord and his unit never suffer the penalty to their Initiative for charging through difficult terrain.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Focus of Adoration" id="a36b-276f-3617-00d7" hidden="false" page="96" publicationId="f840-ed73-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly units with the Genestealer Cults Faction have the Counter-Attack special rule while they are within 12&quot; of your Warlord.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="Psychic Powers" id="a25f-b310-719a-c820" collective="false" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink id="a25f-b310-719a-c820-ff36a6f3-19bf-4f48-8956-adacfd28fe74" hidden="false" primary="true" targetId="ff36a6f3-19bf-4f48-8956-adacfd28fe74"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <selectionEntryGroups>
        <selectionEntryGroup name="Discipline" id="481b-2a09-10f9-3349" collective="false" hidden="false" import="true">
          <constraints>
            <constraint id="65ca-71d9-e454-27b8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <entryLinks>
            <entryLink id="5c2d-c597-51af-e9a3" collective="false" hidden="false" import="true" targetId="7b9c-cc71-5fb2-f287" type="selectionEntry"/>
            <entryLink id="e728-00c3-e284-39ea" collective="false" hidden="false" import="true" targetId="f3dd-c529-d047-3c68" type="selectionEntry"/>
          </entryLinks>
          <selectionEntries>
            <selectionEntry name="Discipline: Broodmind" id="4f24-8155-92f3-6a40" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="New InfoLink" id="609b-c626-d126-9ad4" hidden="false" targetId="3ac5-a550-39f8-f28a" type="rule"/>
                <infoLink name="New InfoLink" id="8642-fed2-d2ec-46ec" hidden="false" targetId="7674-690c-ab59-1444" type="rule"/>
                <infoLink name="New InfoLink" id="69a7-df41-2d59-7237" hidden="false" targetId="39c6-1f20-a156-47f4" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="(Primaris) Mass Hypnosis" id="0f5c-22fe-61fe-7c3d" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">1</characteristic>
                    <characteristic name="Power Category" typeId="f04c-a782-d794-ddad">Malediction</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">24&quot;</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">A single enemy unit has its Weapon Skill, Balistic Skill, Initiative and Attacks reduced by 1, to a minimum of 1.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Psychic Stimulus" id="a645-0cf4-3af2-ff03" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">1</characteristic>
                    <characteristic name="Power Category" typeId="f04c-a782-d794-ddad">Blessing</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">24&quot;</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">A single friendly unit gains the Relentless and Fleet special rules. In addition, the target can charge even if it Ran its preceding Shooting phase.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Psionic Blast" id="decd-b780-d35e-efd1" hidden="false" typeId="9c33-b0c8-74bd-e5a7" typeName="Psychic Power (Attack)">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="c1b6-4261-dee4-923a">1</characteristic>
                    <characteristic name="Power Category" typeId="668e-d504-8244-7422">Witchfire</characteristic>
                    <characteristic name="Range" typeId="5bf6-378a-0cb7-b079">24&quot;</characteristic>
                    <characteristic name="Strength" typeId="12da-9b3e-f37b-bc35">5</characteristic>
                    <characteristic name="AP" typeId="10b5-aa5b-ccde-79cc">3</characteristic>
                    <characteristic name="Type" typeId="20e7-cbcb-1781-a732">Assault 1, Blast</characteristic>
                    <characteristic name="Details" typeId="a812-390d-dff6-dabd"/>
                  </characteristics>
                </profile>
                <profile name="Might From Beyond" id="ba36-f134-cff2-d711" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">1</characteristic>
                    <characteristic name="Power Category" typeId="f04c-a782-d794-ddad">Blessing</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">24&quot;</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">A single friendly unit adds 1 to their Strength characteristic and gains the Rage special rule.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Mental Onslaught" id="ffc9-1422-d298-66c0" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">2</characteristic>
                    <characteristic name="Power Category" typeId="f04c-a782-d794-ddad">Focussed Witchfire</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">24&quot;</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Both the Psyker and the target model roll a dice and add their Leadership value. If the scores are drawn, the target model suffers a -3 penalty to its Initiative until the end of the following turn. If the Pskyer&apos;s score is higher, the target also suffers a number of Wounds equal to the difference between the scores. No armour or cover saves are allowed against these Wounds.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Mind Control" id="abfb-2041-7d30-355a" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">2</characteristic>
                    <characteristic name="Power Category" typeId="f04c-a782-d794-ddad">Focussed Witchfire</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">24&quot;</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">A single non-vehicle model that is not locked in combat immediately makes a shooting attack exactly as if it were one of your own models. The model cannot make an attack that would cause it to hit itself or its own unit in any way. After resolving the shooting attack, the mind-controlled model immediately reverts to the owning player&apos;s control.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Telepathic Summons" id="f3ef-1c17-2621-a4da" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">2 or 3</characteristic>
                    <characteristic name="Power Category" typeId="f04c-a782-d794-ddad">Conjuration</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc"/>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Each time this psychic power is used, choose whether it will have Warp Charge 2 or 3. The choice must be made before the Psychic test is taken.  Warp Charge 2: A single unit of 5 Acolyte Hybrids, 5 Hybrid Metamorphs, or 10 Neophyte Hybrids (your choice).  Warp Charge 3: A single unit of 10 Acolyte Hybrids, 10 Hybrid Metamorphs, 4 Abberants, 8 Purestrain Genestealers, or 20 Neophyte Hybrids (your choice).  In any case, these unit can be equipped with any upgrades listed on their datasheet, but they cannot take any extra models or take a Dedicated Transport. These units always arrive using the Cult Ambush special rule instead of arriving via Deep Strike.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
